# The GitLab lane of a k3s private campaign: the minimal signed release, each
# demo's merge-request gate, the demos' releases, then the narrower policy
# scenarios. Needs a campaign prepared with gitlab=<this file> and job-image=
# for go, java, javascript-typescript and rust, and from the caller
# FORGE_CI_LIVE_CONSUMER_VISIBILITY=private and
# FORGE_CI_LIVE_GITLAB_IMAGE_BUILDER=kaniko, which selects the release image
# builder for the whole lane.
#
#   just campaign-lane <dir> gitlab test/live/campaigns/k3s-private-gitlab.cases
#
# Each gate checks in the runtime image of its demo's toolchain (job-archive=)
# and lints in the nanolinter image of its flavour (lint-archive=);
# hello-monorepo's core lint plan runs in the java flavour, and its gate
# checks the frontend in the node image too. A release runs its job-image jobs
# as the runtime images' nonroot (job-user=65532:65532) and builds with the
# runtime image (build-archive=). hello-cargo-container has no release here:
# its own build runs Buildah, which a kaniko lane does not cover.

scenario TestGitLabRelease_MinimalSignedArtifacts

consumer hello-go-cli pull-request job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_GO lint-archive=@LINT_IMAGE_ARCHIVE_GO
consumer hello-maven pull-request job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA lint-archive=@LINT_IMAGE_ARCHIVE_JAVA
consumer hello-npm-service pull-request job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_NODE lint-archive=@LINT_IMAGE_ARCHIVE_JAVASCRIPT_TYPESCRIPT
consumer hello-cargo-container pull-request job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_RUST lint-archive=@LINT_IMAGE_ARCHIVE_RUST
consumer hello-go-service pull-request job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_GO lint-archive=@LINT_IMAGE_ARCHIVE_GO
consumer hello-maven-service pull-request job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA lint-archive=@LINT_IMAGE_ARCHIVE_JAVA
consumer hello-gradle pull-request job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA lint-archive=@LINT_IMAGE_ARCHIVE_JAVA
consumer hello-monorepo pull-request job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA lint-archive=@LINT_IMAGE_ARCHIVE_JAVA

consumer hello-maven release job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA build-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA signer-archive=@FORGE_CI_LIVE_SIGNER_IMAGE_ARCHIVE lint-archive=@LINT_IMAGE_ARCHIVE_JAVA version=0.2.0 version-bump=maven job-user=65532:65532
consumer hello-npm-service release job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_NODE build-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_NODE signer-archive=@FORGE_CI_LIVE_SIGNER_IMAGE_ARCHIVE lint-archive=@LINT_IMAGE_ARCHIVE_JAVASCRIPT_TYPESCRIPT version=0.2.0 version-bump=npm job-user=65532:65532
consumer hello-maven-service release job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA build-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA signer-archive=@FORGE_CI_LIVE_SIGNER_IMAGE_ARCHIVE lint-archive=@LINT_IMAGE_ARCHIVE_JAVA version=0.2.0 version-bump=maven job-user=65532:65532

scenario TestGitLabCheck_ChecksOutPrivateConsumerWithJobToken
scenario TestGitLabCheck_ChecksOutTheConsumerPipelineCommit
scenario TestGitLabPolicy_ConsumerCannotReplaceTheSigningPipeline
scenario TestGitLabPolicy_JobTokenCannotWriteThePublicationRegistry
scenario TestGitLabRelease_MinimalBranchProtection
scenario TestGitLabRelease_ResourceGroupSpansTheChild
scenario TestGitLabRelease_PromotionRetryAfterRegistryWrite
scenario TestGitLabBootstrap_PublishesAndDownloadsTheRecordedBinary
