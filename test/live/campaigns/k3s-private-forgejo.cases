# The Forgejo lane of a k3s private campaign: each demo's pull request, then
# its release with kaniko image builds. Needs a campaign prepared with
# job-image= for go, java, javascript-typescript and rust, and
# FORGE_CI_LIVE_CONSUMER_VISIBILITY=private from the caller.
#
#   just campaign-lane <dir> forgejo test/live/campaigns/k3s-private-forgejo.cases

consumer hello-go-cli pull-request CI_JOB_IMAGE=@JOB_IMAGE_GO
consumer hello-go-cli release CI_JOB_IMAGE=@JOB_IMAGE_GO RELEASE_PLATFORMS=linux/amd64 CI_IMAGE_BUILDER=kaniko CI_IMAGE_BUILDER_JOB_IMAGE=@KANIKO_JOB_IMAGE

consumer hello-go-service pull-request CI_JOB_IMAGE=@JOB_IMAGE_GO
consumer hello-go-service release CI_JOB_IMAGE=@JOB_IMAGE_GO RELEASE_PLATFORMS=linux/amd64 CI_IMAGE_BUILDER=kaniko CI_IMAGE_BUILDER_JOB_IMAGE=@KANIKO_JOB_IMAGE

consumer hello-maven-service pull-request CI_JOB_IMAGE=@JOB_IMAGE_JAVA
consumer hello-maven-service release CI_JOB_IMAGE=@JOB_IMAGE_JAVA RELEASE_PLATFORMS=linux/amd64 CI_IMAGE_BUILDER=kaniko CI_IMAGE_BUILDER_JOB_IMAGE=@KANIKO_JOB_IMAGE

consumer hello-npm-service pull-request CI_JOB_IMAGE=@JOB_IMAGE_JAVASCRIPT_TYPESCRIPT
consumer hello-npm-service release CI_JOB_IMAGE=@JOB_IMAGE_JAVASCRIPT_TYPESCRIPT RELEASE_PLATFORMS=linux/amd64 CI_IMAGE_BUILDER=kaniko CI_IMAGE_BUILDER_JOB_IMAGE=@KANIKO_JOB_IMAGE

consumer hello-maven pull-request CI_JOB_IMAGE=@JOB_IMAGE_JAVA
consumer hello-maven release CI_JOB_IMAGE=@JOB_IMAGE_JAVA RELEASE_PLATFORMS=linux/amd64 CI_IMAGE_BUILDER=kaniko CI_IMAGE_BUILDER_JOB_IMAGE=@KANIKO_JOB_IMAGE

consumer hello-cargo-container pull-request CI_JOB_IMAGE=@JOB_IMAGE_RUST
consumer hello-cargo-container release CI_JOB_IMAGE=@JOB_IMAGE_RUST RELEASE_PLATFORMS=linux/amd64 CI_IMAGE_BUILDER=kaniko CI_IMAGE_BUILDER_JOB_IMAGE=@KANIKO_JOB_IMAGE
